set nocompatible
filetype plugin indent on
syntax enable
set encoding=utf-8
set fileencodings=utf-8,ascii
set fileformat=unix
set fileformats=unix
set noexpandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set smartindent
set autoindent
set breakindent
set noundofile
set nobackup
set noswapfile
